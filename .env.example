# -----------------------------------------------------------------------------
# Groq High-Intelligence / Ultra-Low Latency Inference Settings
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# Production model: 120B reasoning with ultra-fast turnaround (~0.9s - 1.2s):
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API Credentials
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=EAAG_your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_VERIFY_TOKEN=tektutors_verify_token_secret
# Meta App Secret (used for verifying X-Hub-Signature-256 on production webhooks)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Railway Deployment: Automatically injected when you click 'Add Service -> Database -> PostgreSQL'
# Or manually with Supabase / PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.xxxx.supabase.co:5432/postgres
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./tektutors.db

# -----------------------------------------------------------------------------
# Production & Server Security Settings
# -----------------------------------------------------------------------------
# Environment: 'production' or 'development'
APP_ENV=production
DEBUG=False
PORT=8000
WORKERS=2
# Allowed origins for CORS (comma-separated URLs, e.g. https://tektutors.com.ng,https://admin.tektutors.com.ng or *):
ALLOWED_ORIGINS=*
# Strict webhook signature verification (enforce HMAC SHA256 validation):
WEBHOOK_VERIFY_SIGNATURE_STRICT=True

# -----------------------------------------------------------------------------
# Email Marketing & SMTP Settings (Gmail SSL Configuration)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
# Port 465 (SSL) is strongly recommended to avoid ISP firewall timeouts on Port 587:
SMTP_PORT=465
SMTP_USER=tektutorsng@gmail.com
# 16-character Google App Password (spaces will be automatically stripped):
SMTP_PASSWORD=your_16_letter_app_password
SMTP_FROM_EMAIL=tektutorsng@gmail.com
SMTP_FROM_NAME=TekTutors
SMTP_USE_TLS=False
